@article{Wang_2012_UV,
doi = {10.1088/0004-637X/749/2/126},
url = {https://dx.doi.org/10.1088/0004-637X/749/2/126},
year = {2012},
month = {mar},
publisher = {The American Astronomical Society},
volume = {749},
number = {2},
pages = {126},
author = {Wang, Xiaofeng and Wang, Lifan and Filippenko, Alexei V. and Baron, Eddie and Kromer, Markus and Jack, Dennis and Zhang, Tianmeng and Aldering, Greg and Antilogus, Pierre and Arnett, W. David and Baade, Dietrich and Barris, Brian J. and Benetti, Stefano and Bouchet, Patrice and Burrows, Adam S. and Canal, Ramon and Cappellaro, Enrico and Carlberg, Raymond G. and di Carlo, Elisa and Challis, Peter J. and Crotts, Arlin P. S. and Danziger, John I. and Valle, Massimo Della and Fink, Michael and Foley, Ryan J. and Fransson, Claes and Gal-Yam, Avishay and Garnavich, Peter M. and Gerardy, Chris L. and Goldhaber, Gerson and Hamuy, Mario and Hillebrandt, Wolfgang and Höflich, Peter and Holland, Stephen T. and Holz, Daniel E. and Hughes, John P. and Jeffery, David J. and Jha, Saurabh W. and Kasen, Dan and Khokhlov, Alexei M. and Kirshner, Robert P. and Knop, Robert A. and Kozma, Cecilia and Krisciunas, Kevin and Lee, Brian C. and Leibundgut, Bruno and Lentz, Eric J. and Leonard, Douglas C. and Lewin, Walter H. G. and Li, Weidong and Livio, Mario and Lundqvist, Peter and Maoz, Dan and Matheson, Thomas and Mazzali, Paolo A. and Meikle, Peter and Miknaitis, Gajus and Milne, Peter A. and Mochnacki, Stefan W. and Nomoto, Ken'ichi and Nugent, Peter E. and Oran, Elaine S. and Panagia, Nino and Perlmutter, Saul and Phillips, Mark M. and Pinto, Philip and Poznanski, Dovi and Pritchet, Christopher J. and Reinecke, Martin and Riess, Adam G. and Ruiz-Lapuente, Pilar and Scalzo, Richard A. and Schlegel, Eric M. and Schmidt, Brian P. and Siegrist, James and Soderberg, Alicia M. and Sollerman, Jesper and Sonneborn, George and Spadafora, Anthony and Spyromilio, Jason and Sramek, Richard A. and Starrfield, Sumner G. and Strolger, Louis G. and Suntzeff, Nicholas B. and Thomas, Rollin C. and Tonry, John L. and Tornambe, Amedeo and Truran, James W. and Turatto, Massimo and Turner, Michael and Van Dyk, Schuyler D. and Weiler, Kurt W. and Wheeler, J. Craig and Wood-Vasey, Michael and Woosley, Stanford E. and Yamaoka, Hitoshi},
title = {EVIDENCE FOR TYPE Ia SUPERNOVA DIVERSITY FROM ULTRAVIOLET OBSERVATIONS WITH THE HUBBLE SPACE TELESCOPE},
journal = {The Astrophysical Journal},
abstract = {We present ultraviolet (UV) spectroscopy and photometry of four Type Ia supernovae (SNe 2004dt, 2004ef, 2005M, and 2005cf) obtained with the UV prism of the Advanced Camera for Surveys on the Hubble Space Telescope. This data set provides unique spectral time series down to 2000 Å. Significant diversity is seen in the near-maximum-light spectra (∼2000–3500 Å) for this small sample. The corresponding photometric data, together with archival data from Swift Ultraviolet/Optical Telescope observations, provide further evidence of increased dispersion in the UV emission with respect to the optical. The peak luminosities measured in the uvw1/F250W filter are found to correlate with the B-band light-curve shape parameter Δm15(B), but with much larger scatter relative to the correlation in the broadband B band (e.g., ∼0.4 mag versus ∼0.2 mag for those with 0.8 mag &lt; Δm15(B) &lt; 1.7 mag). SN 2004dt is found as an outlier of this correlation (at &gt; 3σ), being brighter than normal SNe Ia such as SN 2005cf by ∼0.9 mag and ∼2.0 mag in the uvw1/F250W and uvm2/F220W filters, respectively. We show that different progenitor metallicity or line-expansion velocities alone cannot explain such a large discrepancy. Viewing-angle effects, such as due to an asymmetric explosion, may have a significant influence on the flux emitted in the UV region. Detailed modeling is needed to disentangle and quantify the above effects.}
}

